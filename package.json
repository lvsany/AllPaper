{
  "name": "allpaper",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first research workbench for reading, thinking and writing papers.",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsx scripts/build-electron.ts",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:dmg": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.allpaper.desktop",
    "productName": "AllPaper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
